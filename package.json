{
  "name": "yagovfx-github-io-tests",
  "private": true,
  "description": "Solo dependencias de prueba (accesibilidad con axe-core). La web en producción no usa npm.",
  "scripts": {
    "test:js": "node scripts/test-js.cjs",
    "test:e2e": "python -m pytest -q tests/e2e",
    "test:py": "python -m pytest -q tests --ignore=tests/e2e"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "axe-core": "^4.10.0",
    "firebase": "^13.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
