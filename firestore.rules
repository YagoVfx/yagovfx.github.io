rules_version = '2';

// Reglas de seguridad de Firestore para yagovfx.github.io
// DESPLIEGUE (manual, solo tú puedes hacerlo): Firebase Console → Firestore Database → Rules → pegar → Publish.
// Administrador identificado por el UID de Authentication → Usuarios.
service cloud.firestore {
  match /databases/{database}/documents {

    // Documento público del portfolio: lo lee cualquier visitante, SOLO el administrador autenticado lo escribe.
    match /portfolio/main {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == 'ylQ3m3XoCHTd0cwP7UQet7cSRpt1';
    }

    // Candidaturas personales: nunca forman parte del documento público.
    match /users/{userId}/applications/{applicationId} {
      function owner() {
        return request.auth != null
          && request.auth.uid == 'ylQ3m3XoCHTd0cwP7UQet7cSRpt1'
          && request.auth.uid == userId;
      }
      function validApplication() {
        let d = request.resource.data;
        return d.keys().hasAll(['id','company','title','url','location','status','appliedAt','updatedAt','notes'])
          && d.keys().hasOnly(['id','company','title','url','location','status','appliedAt','updatedAt','notes'])
          && d.id == applicationId && d.id is string && d.id.size() <= 200
          && d.company is string && d.company.size() > 0 && d.company.size() <= 200
          && d.title is string && d.title.size() > 0 && d.title.size() <= 300
          && d.url is string && d.url.size() <= 2000 && (d.url == '' || d.url.matches('https?://.*'))
          && d.location is string && d.location.size() <= 500
          && d.status in ['applied','interview','offer','rejected','withdrawn']
          && d.appliedAt is string && d.appliedAt.size() <= 40
          && d.updatedAt is string && d.updatedAt.size() <= 40
          && d.notes is string && d.notes.size() <= 2000;
      }
      allow read, delete: if owner();
      allow create, update: if owner() && validApplication();
    }

    // Todo lo demás, denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
